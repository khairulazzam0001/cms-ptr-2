# Copy ke .env
PORT=3001
# Origin frontend untuk CORS
FRONTEND_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=1234
DB_NAME=cms_master
# WAJIB diisi (server menolak start bila kosong). Ganti dengan string acak >= 32 karakter.
JWT_SECRET=ganti-secret-min-32-karakter
JWT_EXPIRES=12h
# Single admin (dipakai seed + login)
ADMIN_USERNAME=admin
# hash bcrypt dari ADMIN_PASSWORD, dibuat via npm run seed:admin
ADMIN_PASSWORD=admin123
UPLOAD_DIR=./uploads
MAX_FILE_MB=10
# Google Sheets sync (scheduler + tombol manual)
# 1) Buat Service Account di Google Cloud, download JSON key
# 2) Isi salah satu: JSON mentah satu baris, atau path file json
# 3) Share spreadsheet ke client_email service account sebagai Editor
# 4) Set SHEETS_SYNC_ENABLED=true kalau sudah siap
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
SHEETS_SYNC_ENABLED=false
# Cron scheduler (default tiap jam). Contoh: tiap 15 menit "*/15 * * * *"
SHEETS_CRON=0 * * * *
# CSV ke folder Google Drive (scheduler + tombol manual, file di-overwrite per nama)
# Syarat tambahan: enable Google Drive API + share folder ke service account sebagai Content manager/Editor
# ID folder dari URL: .../drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_SYNC_ENABLED=false
DRIVE_CRON=0 * * * *
